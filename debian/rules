#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PATH_DEV_PKG=debian/libtensorflow-lite-dev
PATH_DEV_HEADERS=${PATH_DEV_PKG}/usr/include/tensorflow
BUILDDIR=${CURDIR}/debian/build

%:
	dh $@ --sourcedirectory=tensorflow/lite --builddirectory=${BUILDDIR}

# See upstream instructions:
# https://ai.google.dev/edge/litert/build/cmake

override_dh_auto_configure:
	dh_auto_configure --\
		-Wno-dev \
		-DFETCHCONTENT_FULLY_DISCONNECTED=OFF \
		-DTFLITE_BUILD_SHARED_LIB=on \
		-DTFLITE_ENABLE_NNAPI=OFF \
		-DTFLITE_ENABLE_NNAPI_VERBOSE_VALIDATION=on \
		-DTFLITE_ENABLE_RUY=ON \
		-DTFLITE_ENABLE_XNNPACK=ON \
		-DTFLITE_ENABLE_EXTERNAL_DELEGATE=ON \
		-DCMAKE_FIND_PACKAGE_PREFER_CONFIG=ON \
		-DSYSTEM_FARMHASH=ON \
		-DSYSTEM_PTHREADPOOL=ON \
		-Dabsl_DIR=/usr/lib/cmake/absl \
		-DEigen3_DIR=/usr/share/eigen3/cmake \
		-DFlatBuffers_DIR=/usr/lib/cmake/flatbuffers \
		-Dgemmlowp_DIR=/usr/lib/cmake/gemmlowp \
		-DNEON_2_SSE_DIR=/usr/lib/cmake/NEON_2_SSE \
		$(NULL)

override_dh_install:
	install -d usr/include/tensorflow/lite
	install -d usr/include/tensorflow/core/public
	ls -lha ${BUILDDIR}
	cp --no-preserve=ownership -d ${BUILDDIR}/libtensorflow-lite.so.2.16.2 debian/tmp/usr/lib
	cp --no-preserve=ownership -d ${BUILDDIR}/libtensorflow-lite.so debian/tmp/usr/lib
#	cp --parents $(find . -name "*.h*") usr/include/tensorflow/lite
	find tensorflow/lite -name "*.h*" -exec cp --parents {} usr/include/tensorflow/lite \;
	cp tensorflow/core/public/version.h usr/include/tensorflow/core/public
#install -d ${PATH_DEV_HEADERS}/lite/profiling/telemetry/c/
	dh_install

override_dh_missing:
#dh_missing --exclude=ruy/ruy/*

override_dh_makeshlibs:
	# Don't make disappearing symbols fatal, for now.
	dh_makeshlibs -- -c0
